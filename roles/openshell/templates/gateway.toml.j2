# Managed by githubixx.ai.openshell. Change role variables rather than this file.
[openshell]
version = 2

[openshell.gateway]
bind_address = "{{ openshell_gateway_bind_address }}"
compute_driver = "{{ openshell_compute_driver }}"

[openshell.drivers.docker]
socket_path = "/var/run/docker.sock"
default_image = "{{ openshell_default_image }}"
image_pull_policy = "if_not_present"
sandbox_label = "docker-dev"
enable_bind_mounts = false
sandbox_pids_limit = 2048
